# Base URL of the Express API.
VITE_API_URL=http://localhost:5000
# Public Razorpay key ID used by the checkout widget.
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
# Google OAuth client ID used by the sign-in button.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
# Time zone used for frontend travel-date calculations.
VITE_APP_TIMEZONE=Asia/Kolkata
# Maximum booking horizon used by frontend date validation.
VITE_BOOKING_WINDOW_DAYS=30
