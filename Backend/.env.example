# Node runtime mode controls development-only behavior.
NODE_ENV=development
# HTTP port for the Express server.
PORT=5000
# Single allowed browser origin when CLIENT_URLS is unset.
CLIENT_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS.
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# IANA time zone used for booking date calculations.
APP_TIMEZONE=Asia/Kolkata
# Minimum minutes before departure when bookings are cut off.
BOOKING_CUTOFF_MINUTES=0
# Maximum number of days in advance a booking can be made.
BOOKING_WINDOW_DAYS=30
# MongoDB connection string for the backend and scripts.
MONGODB_URI=your_mongodb_uri_here
# Secret used to sign authentication JWTs.
JWT_SECRET=replace_with_a_long_random_secret
# Lifetime of authentication JWTs.
JWT_EXPIRES_IN=7d
# Google OAuth client ID verified by the backend.
GOOGLE_CLIENT_ID=your_google_client_id_here
# SMTP account used to send email OTPs.
EMAIL_USER=your_email_address_here
# SMTP app password used by Nodemailer.
EMAIL_APP_PASSWORD=your_email_app_password_here
# Duration of bus seat locks in minutes.
SEAT_LOCK_MINUTES=10
# Razorpay public key ID.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
# Razorpay API secret.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Signature secret for the main Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Optional separate signature secret for train webhooks.
RAZORPAY_TRAIN_WEBHOOK_SECRET=your_razorpay_train_webhook_secret_here
# Name used by the admin creation script.
ADMIN_NAME=your_admin_name_here
# Email used by the admin creation script.
ADMIN_EMAIL=your_admin_email_here
# Password used by the admin creation script.
ADMIN_PASSWORD=replace_with_a_strong_admin_password
# General API rate-limit window in minutes.
RATE_LIMIT_WINDOW_MINUTES=15
# Maximum general API requests per IP per window.
RATE_LIMIT_MAX=200
# Maximum booking API requests per IP per window.
BOOKING_RATE_LIMIT_MAX=30
# Maximum OTP send requests per IP per window.
OTP_SEND_RATE_LIMIT_MAX=6
# Maximum OTP verification requests per IP per window.
OTP_VERIFY_RATE_LIMIT_MAX=10
# Minimum seconds between OTP sends to the same email and purpose.
OTP_RESEND_COOLDOWN_SECONDS=30
# Maximum OTP sends per email and purpose in the one-hour window.
OTP_MAX_SENDS_PER_HOUR=8
# Enables non-production Razorpay sandbox/mock payment mode.
ALLOW_SANDBOX_PAYMENT=false
# Alternate non-production flag enabling mock payment mode.
ENABLE_MOCK_PAYMENT=false
# Optional host time zone used by date verification scripts.
TZ=UTC
