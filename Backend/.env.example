# Server
NODE_ENV=
PORT=
CLIENT_URL=
CLIENT_URLS=http://localhost:5173,http://localhost:5174
APP_TIMEZONE=Asia/Kolkata
BOOKING_CUTOFF_MINUTES=0

# Database
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=
GOOGLE_CLIENT_ID=

# Email OTP (Nodemailer + Gmail SMTP)
EMAIL_USER=
EMAIL_APP_PASSWORD=
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Seat Locking
SEAT_LOCK_MINUTES=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TRAIN_WEBHOOK_SECRET=

# Admin Seed Credentials
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=
RATE_LIMIT_MAX=
OTP_RATE_LIMIT_MAX=

# Payment Sandbox Mode (Set to false or omit in production)
ALLOW_SANDBOX_PAYMENT=false
